@@ -0,0 +1,237 @@
+//! Synthetic-only characterization and serial release microcomparison.
+use super::*;
+use std::{
+    hint::black_box,
+    time::{Duration, Instant},
+};
+
+// Frozen a975449 scalar gutter. No span calculation or candidate fill helper.
+fn oracle(level: &Level, tile: Tile) -> Result<Vec<u8>, LoadError> {
+    let bpp = level.bytes_per_pixel();
+    let mut data = allocation(tile.bytes_at_depth(bpp))?;
+    let width = tile.size[0] + 2;
+    for y in 0..tile.size[1] + 2 {
+        let sy = (tile.origin[1] + y)
+            .saturating_sub(1)
+            .min(level.size[1] - 1);
+        for x in 0..width {
+            let sx = (tile.origin[0] + x)
+                .saturating_sub(1)
+                .min(level.size[0] - 1);
+            let from = (sy * level.size[0] + sx) * bpp;
+            let to = (y * width + x) * bpp;
+            data[to..to + bpp].copy_from_slice(&level.rgba[from..from + bpp]);
+        }
+    }
+    Ok(data)
+}
+
+fn synthetic(size: [usize; 2], half: bool, pattern: usize) -> Level {
+    let bpp = if half { 8 } else { 4 };
+    let rgba = (0..size[1])
+        .flat_map(|y| {
+            (0..size[0]).flat_map(move |x| {
+                (0..bpp).map(move |c| {
+                    if pattern == 0 {
+                        (x * 37 + y * 71 + c * 109 + (x >> 8) * 17 + (y >> 8) * 23) as u8
+                    } else {
+                        let mut n = (y * size[0] * bpp + x * bpp + c) as u64;
+                        n = n.wrapping_add(0x9e3779b97f4a7c15);
+                        n = (n ^ (n >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);
+                        n = (n ^ (n >> 27)).wrapping_mul(0x94d049bb133111eb);
+                        (n ^ (n >> 31)) as u8
+                    }
+                })
+            })
+        })
+        .collect();
+    Level { size, rgba, half }
+}
+
+fn check(level: &Level, tile: Tile) {
+    let expected = oracle(level, tile).unwrap();
+    for kernel in [Kernel::Scalar, Kernel::RowSpan] {
+        let mut actual = vec![0xa5; tile.bytes_at_depth(level.bytes_per_pixel())];
+        fill(level, tile, &mut actual, kernel);
+        assert_eq!(actual.len(), expected.len());
+        if let Some(i) = actual.iter().zip(&expected).position(|(a, b)| a != b) {
+            panic!(
+                "byte mismatch: level={:?} half={} tile={tile:?} kernel={kernel:?} byte={i} actual={} expected={}",
+                level.size, level.half, actual[i], expected[i]
+            );
+        }
+    }
+}
+
+#[test]
+fn exact_bytes_small_all_tiles_both_depths_and_patterns() {
+    for half in [false, true] {
+        for pattern in 0..2 {
+            for w in 1..=9 {
+                for h in 1..=9 {
+                    let level = synthetic([w, h], half, pattern);
+                    for core in 1..=5 {
+                        for key in coverage(level.size, 0, core, [0.0, 0.0, 1.0, 1.0]) {
+                            check(&level, tile(level.size, key, core));
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn exact_bytes_production_boundaries_and_heavy_geometry() {
+    for half in [false, true] {
+        for pattern in 0..2 {
+            for size in [
+                [1021, 1023],
+                [2045, 1023],
+                [1, 2053],
+                [2053, 1],
+                [1280, 2052],
+                [640, 1026],
+            ] {
+                let level = synthetic(size, half, pattern);
+                for key in coverage(size, 0, 1022, [0.0, 0.0, 1.0, 1.0]) {
+                    check(&level, tile(size, key, 1022));
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn initialized_allocation_and_capacity_error_remain_fallible() {
+    assert_eq!(allocation(17).unwrap(), [0; 17]);
+    // Capacity overflow is rejected without attempting real OOM.
+    assert!(matches!(
+        allocation(usize::MAX),
+        Err(LoadError::ResourceLimit(_))
+    ));
+}
+
+fn allocated(level: &Level, tile: Tile, kernel: Kernel) -> Vec<u8> {
+    let mut data = allocation(tile.bytes_at_depth(level.bytes_per_pixel())).unwrap();
+    fill(level, tile, &mut data, kernel);
+    data
+}
+
+fn consume(data: &[u8]) {
+    black_box(data);
+    black_box((data[0], data[data.len() / 2], data[data.len() - 1]));
+}
+
+#[test]
+#[ignore = "synthetic serial release timing only; no images or GUI"]
+fn benchmark_gutters() {
+    if cfg!(debug_assertions) {
+        panic!("use --release");
+    }
+    eprintln!(
+        "GUTTER methodology: synthetic 1280x2052; 10 warmups/variant/mode/case; five 200ms wall blocks; alternating order; ns exclude output consumption and drop; no profiling; CPU wall, not GUI/GPU/FPS"
+    );
+    eprintln!(
+        "GUTTER bpp width height ox oy mode block order kernel iterations measured_ns block_wall_ns mean_ns"
+    );
+    for half in [false, true] {
+        let level = synthetic([1280, 2052], half, 1);
+        for (case, key) in [
+            Key {
+                level: 0,
+                x: 0,
+                y: 0,
+            },
+            Key {
+                level: 0,
+                x: 1,
+                y: 0,
+            },
+            Key {
+                level: 0,
+                x: 0,
+                y: 2,
+            },
+            Key {
+                level: 0,
+                x: 1,
+                y: 2,
+            },
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let tile = tile(level.size, key, 1022);
+            check(&level, tile);
+            for (mode_index, mode) in ["allocation-fill", "fill-only"].into_iter().enumerate() {
+                let mut buffer = allocation(tile.bytes_at_depth(level.bytes_per_pixel())).unwrap();
+                for kernel in [Kernel::Scalar, Kernel::RowSpan] {
+                    for _ in 0..10 {
+                        if mode_index == 0 {
+                            consume(&allocated(
+                                black_box(&level),
+                                black_box(tile),
+                                black_box(kernel),
+                            ));
+                        } else {
+                            fill(
+                                black_box(&level),
+                                black_box(tile),
+                                black_box(&mut buffer),
+                                black_box(kernel),
+                            );
+                            consume(&buffer);
+                        }
+                    }
+                }
+                for block in 0..5 {
+                    let order = if (block + case + mode_index) % 2 == 0 {
+                        [Kernel::Scalar, Kernel::RowSpan]
+                    } else {
+                        [Kernel::RowSpan, Kernel::Scalar]
+                    };
+                    for (position, kernel) in order.into_iter().enumerate() {
+                        let wall = Instant::now();
+                        let mut measured = Duration::ZERO;
+                        let mut iterations = 0u64;
+                        while wall.elapsed() < Duration::from_millis(200) {
+                            let start = Instant::now();
+                            if mode_index == 0 {
+                                let data = allocated(
+                                    black_box(&level),
+                                    black_box(tile),
+                                    black_box(kernel),
+                                );
+                                measured += start.elapsed();
+                                consume(&data);
+                                drop(data);
+                            } else {
+                                fill(
+                                    black_box(&level),
+                                    black_box(tile),
+                                    black_box(&mut buffer),
+                                    black_box(kernel),
+                                );
+                                measured += start.elapsed();
+                                consume(&buffer);
+                            }
+                            iterations += 1;
+                        }
+                        let wall_ns = wall.elapsed().as_nanos();
+                        eprintln!(
+                            "GUTTER {} {} {} {} {} {mode} {block} {position} {kernel:?} {iterations} {} {wall_ns} {:.3}",
+                            level.bytes_per_pixel(),
+                            tile.size[0],
+                            tile.size[1],
+                            tile.origin[0],
+                            tile.origin[1],
+                            measured.as_nanos(),
+                            measured.as_nanos() as f64 / iterations as f64
+                        );
+                    }
+                }
+            }
+        }
+    }
+}
