new file mode 100644
index 0000000..736bc0f
--- /dev/null
+++ b/src/profile.rs
@@ -0,0 +1,424 @@
+//! Temporary, single-window diagnostic. Disabled runs do not lock or read a clock.
+use std::{
+    collections::BTreeMap,
+    sync::{
+        Mutex, OnceLock,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+const CAP: usize = 32768;
+static PROFILE: OnceLock<Option<Mutex<Profile>>> = OnceLock::new();
+static STEADY: AtomicBool = AtomicBool::new(false);
+static DETAILS: AtomicBool = AtomicBool::new(false);
+static TIMERS: AtomicBool = AtomicBool::new(true);
+
+pub fn details() -> bool {
+    enabled() && DETAILS.load(Ordering::Relaxed) && TIMERS.load(Ordering::Relaxed)
+}
+pub fn stamp() -> Option<Instant> {
+    details().then(Instant::now)
+}
+pub fn elapsed(start: Option<Instant>) -> Duration {
+    start.map_or(Duration::ZERO, |start| start.elapsed())
+}
+
+// Record local, disjoint leaves only after the envelope has stopped. Residual
+// includes bookkeeping, destruction and clock overhead, not another GPU stage.
+pub fn breakdown(
+    envelope: Option<(bool, Duration)>,
+    parts: &[(&'static str, Duration)],
+    residual: &'static str,
+    failed: &'static str,
+    is_error: bool,
+) {
+    if !details() {
+        return;
+    }
+    let Some((steady, total)) = envelope else {
+        return;
+    };
+    let mut p = state().expect("enabled details").lock().unwrap();
+    for &(name, duration) in parts {
+        p.record(steady, name, duration);
+    }
+    let leaves: Duration = parts.iter().map(|(_, d)| *d).sum();
+    p.record(steady, residual, total.saturating_sub(leaves));
+    if leaves > total {
+        p.record(steady, "attribution_overlap", leaves - total);
+    }
+    if is_error {
+        p.record(steady, failed, total);
+    }
+}
+
+#[derive(Default)]
+struct Samples {
+    values: Vec<f64>,
+    dropped: usize,
+}
+impl Samples {
+    fn push(&mut self, value: f64) {
+        if self.values.len() < CAP {
+            self.values.push(value);
+        } else {
+            self.dropped += 1;
+        }
+    }
+    fn summary(&mut self) -> [f64; 4] {
+        self.values.sort_by(f64::total_cmp);
+        let n = self.values.len();
+        if n == 0 {
+            return [0.0; 4];
+        }
+        let median = (self.values[(n - 1) / 2] + self.values[n / 2]) / 2.0;
+        [
+            self.values.iter().sum::<f64>() / n as f64,
+            median,
+            self.values[(95 * n).div_ceil(100) - 1],
+            self.values[n - 1],
+        ]
+    }
+}
+struct Profile {
+    start: Instant,
+    seconds: u64,
+    auto_stopped: bool,
+    samples: BTreeMap<(bool, &'static str), Samples>,
+    first: Option<Instant>,
+    last: Option<Instant>,
+    request: Option<Instant>,
+    ready: Option<Instant>,
+    taken: Option<Instant>,
+    admissions: usize,
+    wraps: usize,
+    geometry: Option<[f32; 6]>,
+    geometry_changes: usize,
+    playback: Option<(&'static str, bool)>,
+    playback_changes: usize,
+}
+impl Profile {
+    fn record(&mut self, steady: bool, name: &'static str, elapsed: Duration) {
+        self.samples
+            .entry((steady, name))
+            .or_default()
+            .push(elapsed.as_secs_f64() * 1000.0);
+    }
+}
+fn state() -> Option<&'static Mutex<Profile>> {
+    PROFILE.get().and_then(Option::as_ref)
+}
+pub fn enabled() -> bool {
+    state().is_some()
+}
+
+pub fn init() {
+    DETAILS.store(
+        std::env::var("GLANCE_PROFILE_DETAILS").as_deref() != Ok("0"),
+        Ordering::Relaxed,
+    );
+    TIMERS.store(
+        std::env::var("GLANCE_PROFILE_TIMERS").as_deref() != Ok("0"),
+        Ordering::Relaxed,
+    );
+    let seconds = std::env::var("GLANCE_PROFILE_SECONDS").ok().map(|value| {
+        value
+            .parse::<u64>()
+            .ok()
+            .filter(|n| (1..=120).contains(n))
+            .expect("GLANCE_PROFILE_SECONDS must be an integer from 1 through 120")
+    });
+    let _ = PROFILE.set(seconds.map(|seconds| {
+        Mutex::new(Profile {
+            start: Instant::now(),
+            seconds,
+            auto_stopped: false,
+            samples: BTreeMap::new(),
+            first: None,
+            last: None,
+            request: None,
+            ready: None,
+            taken: None,
+            admissions: 0,
+            wraps: 0,
+            geometry: None,
+            geometry_changes: 0,
+            playback: None,
+            playback_changes: 0,
+        })
+    }));
+}
+
+pub struct Timer(Option<(Instant, bool, &'static str)>);
+pub fn timer(name: &'static str) -> Timer {
+    Timer(
+        (enabled() && TIMERS.load(Ordering::Relaxed))
+            .then(|| (Instant::now(), STEADY.load(Ordering::Relaxed), name)),
+    )
+}
+impl Timer {
+    pub fn finish(mut self) -> Option<(bool, Duration)> {
+        self.record()
+    }
+    fn record(&mut self) -> Option<(bool, Duration)> {
+        let (start, steady, name) = self.0.take()?;
+        let elapsed = start.elapsed();
+        state()
+            .expect("enabled timer")
+            .lock()
+            .unwrap()
+            .record(steady, name, elapsed);
+        Some((steady, elapsed))
+    }
+    pub fn cancel(mut self) {
+        self.0 = None;
+    }
+}
+impl Drop for Timer {
+    fn drop(&mut self) {
+        self.record();
+    }
+}
+
+// These events describe one diagnostic window's serial worker/admission pipeline.
+pub fn event(name: &'static str) {
+    let Some(state) = state() else {
+        return;
+    };
+    let now = Instant::now();
+    let mut p = state.lock().unwrap();
+    match name {
+        "request" => {
+            if let Some(last) = p.last {
+                p.record(true, "admit_to_request", now - last);
+            }
+            p.request = Some(now);
+        }
+        "ready" => {
+            if let Some(request) = p.request.take() {
+                p.record(true, "request_to_ready", now - request);
+            }
+            p.ready = Some(now);
+        }
+        "taken" => {
+            if let Some(ready) = p.ready.take() {
+                p.record(true, "ready_to_take", now - ready);
+            }
+            p.taken = Some(now);
+        }
+        "admit" => {
+            if let Some(last) = p.last {
+                p.record(true, "admission_interval", now - last);
+            } else {
+                let start = p.start;
+                p.record(false, "launch_to_first_admission", now - start);
+                p.first = Some(now);
+                STEADY.store(true, Ordering::Relaxed);
+            }
+            if let Some(taken) = p.taken.take() {
+                p.record(true, "take_to_admit", now - taken);
+            }
+            p.last = Some(now);
+            p.admissions += 1;
+        }
+        "wrap" => p.wraps += 1,
+        _ => unreachable!("diagnostic event"),
+    }
+}
+
+pub fn geometry(values: [f32; 6]) {
+    let Some(state) = state() else {
+        return;
+    };
+    let mut p = state.lock().unwrap();
+    if p.geometry.is_some_and(|old| old != values) {
+        p.geometry_changes += 1;
+    }
+    p.geometry = Some(values);
+}
+pub fn playback(rate: &'static str, paused: bool) {
+    let Some(state) = state() else {
+        return;
+    };
+    let mut p = state.lock().unwrap();
+    let value = (rate, paused);
+    if p.playback.is_some_and(|old| old != value) {
+        p.playback_changes += 1;
+    }
+    p.playback = Some(value);
+}
+pub fn expired(ctx: &eframe::egui::Context) -> bool {
+    let Some(state) = state() else {
+        return false;
+    };
+    let mut p = state.lock().unwrap();
+    let remaining = Duration::from_secs(p.seconds).saturating_sub(p.start.elapsed());
+    ctx.request_repaint_after(remaining);
+    p.auto_stopped |= remaining.is_zero();
+    remaining.is_zero()
+}
+pub fn report() {
+    let Some(state) = state() else {
+        return;
+    };
+    let mut p = state.lock().unwrap();
+    eprintln!(
+        "PROFILE elapsed_s={:.6} auto_stopped={}",
+        p.start.elapsed().as_secs_f64(),
+        p.auto_stopped
+    );
+    eprintln!(
+        "PROFILE seconds={} admissions={} wraps={} geometry={:?} geometry_changes={}",
+        p.seconds, p.admissions, p.wraps, p.geometry, p.geometry_changes
+    );
+    eprintln!(
+        "PROFILE playback={:?} playback_changes={}",
+        p.playback, p.playback_changes
+    );
+    eprintln!(
+        "PROFILE geometry: viewport points w,h; canvas points w,h; pixels/point; physical image scale. Default Fit, honor-file rate; session-only defaults."
+    );
+    if let Some((first, last)) = p.first.zip(p.last) {
+        let seconds = (last - first).as_secs_f64();
+        if seconds > 0.0 {
+            eprintln!(
+                "PROFILE admission_span_s={seconds:.6} admissions_per_s={:.4}",
+                (p.admissions - 1) as f64 / seconds
+            );
+        }
+    }
+    eprintln!(
+        "PROFILE gutter={:?} details={} timers={} pending_request={} pending_ready={} pending_taken={}",
+        crate::tiles::kernel(),
+        details(),
+        TIMERS.load(Ordering::Relaxed),
+        p.request.is_some(),
+        p.ready.is_some(),
+        p.taken.is_some()
+    );
+    eprintln!(
+        "PROFILE leaves are nested inside batch/upload/callback envelopes; do not sum envelopes. Phase is envelope start; boundary work can be unmatched. Retained sums exclude dropped samples. Failed batches include partial work/drain."
+    );
+    eprintln!(
+        "PROFILE phase stage n dropped avg_ms median_ms p95_ms worst_ms retained_sum_ms (nearest-rank p95; CPU wall time, NOT GPU/presentation)"
+    );
+    for ((steady, name), samples) in &mut p.samples {
+        let [avg, median, p95, worst] = samples.summary();
+        eprintln!(
+            "PROFILE {} {name} {} {} {avg:.6} {median:.6} {p95:.6} {worst:.6} {:.6}",
+            if *steady { "steady" } else { "startup" },
+            samples.values.len(),
+            samples.dropped,
+            samples.values.iter().sum::<f64>()
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn percentiles_handle_empty_single_odd_even_and_nearest_rank() {
+        let mut s = Samples::default();
+        assert_eq!(s.summary(), [0.0; 4]);
+        s.push(7.0);
+        assert_eq!(s.summary(), [7.0; 4]);
+        s.push(1.0);
+        assert_eq!(s.summary(), [4.0, 4.0, 7.0, 7.0]);
+        s.push(4.0);
+        assert_eq!(s.summary(), [4.0, 4.0, 7.0, 7.0]);
+        let mut s = Samples::default();
+        for n in (1..=100).rev() {
+            s.push(n as f64);
+        }
+        assert_eq!(s.summary(), [50.5, 50.5, 95.0, 100.0]);
+    }
+    #[test]
+    fn collector_is_bounded_and_reports_drops() {
+        let mut s = Samples::default();
+        for _ in 0..CAP + 3 {
+            s.push(1.0);
+        }
+        assert_eq!(s.values.len(), CAP);
+        assert_eq!(s.dropped, 3);
+    }
+    #[test]
+    fn controls_local_breakdown_and_auto_stop_without_a_window() {
